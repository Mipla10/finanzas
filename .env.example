# Copia este archivo a .env (ignorado por git) y rellena los valores vacíos.
# Las credenciales de Postgres de abajo son SOLO para tu entorno local.
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=finanzas
POSTGRES_DB=finanzas
DATABASE_URL=postgresql+psycopg://finanzas:finanzas@localhost:5432/finanzas
TEST_DATABASE_URL=postgresql+psycopg://finanzas:finanzas@localhost:5432/finanzas_test
# Contraseña de la app (mínimo 12 caracteres). Nunca la subas a git.
APP_PASSWORD=
# local = /docs visible; production = /docs desactivado (valor por defecto).
APP_ENV=local
